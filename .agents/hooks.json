{
  "critical-zones-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/guard-critical-zones.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
